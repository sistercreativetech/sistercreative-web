{
  "name": "sistercreative-github",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-19",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/",
      "/admin/api",
      "/admin/api/",
      "/webhook/npl-admin-api",
      "/webhook/npl-admin-api/"
    ]
  }
}
