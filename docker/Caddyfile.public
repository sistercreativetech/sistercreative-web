# Pilihan B: dipakai HANYA bila VPS belum punya reverse proxy di port 80/443.
# Caddy mengambil sertifikat HTTPS otomatis untuk domain di bawah.
# Di Cloudflare: SSL/TLS mode "Full (strict)".
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	}
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode zstd gzip

	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent

	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=604800"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}

	request_body {
		max_size 6MB
	}
}
