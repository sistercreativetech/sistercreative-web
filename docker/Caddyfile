# Caddy internal: sajikan file upload (/media) dan teruskan sisanya ke Django.
# Berjalan di HTTP biasa; HTTPS ditangani proxy di depannya (Traefik VPS atau
# Caddy publik, lihat docker/Caddyfile.public dan README).
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=604800"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}

	request_body {
		max_size 6MB
	}

	log {
		output stdout
		format console
	}
}
