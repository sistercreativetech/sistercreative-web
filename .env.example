# Salin ke .env lalu isi. Jangan commit .env.
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Alamat tersembunyi untuk Django admin bawaan (akhiri dengan /)
DJANGO_ADMIN_URL=kelola-rahasia/

# PostgreSQL (dipakai di produksi)
POSTGRES_DB=sistercreative
POSTGRES_USER=sistercreative
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kontak publik
CONTACT_WHATSAPP=6285737086612

# Email (kosongkan untuk menampilkan email di konsol saat pengembangan)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Sister Creative <noreply@sistercreative.tech>
# none | optional | mandatory  (pakai mandatory setelah SMTP siap)
ACCOUNT_EMAIL_VERIFICATION=none
