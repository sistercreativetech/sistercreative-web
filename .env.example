# Salin ke .env lalu isi. Jangan commit .env.
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Alamat tersembunyi untuk Django admin bawaan (akhiri dengan /)
DJANGO_ADMIN_URL=kelola-rahasia/

# PostgreSQL (dipakai di produksi)
POSTGRES_DB=sistercreative
POSTGRES_USER=sistercreative
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kontak publik
CONTACT_WHATSAPP=6285737086612

# Email (kosongkan untuk menampilkan email di konsol saat pengembangan)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Sister Creative <noreply@sistercreative.tech>
# none | optional | mandatory  (pakai mandatory setelah SMTP siap)
ACCOUNT_EMAIL_VERIFICATION=none

# Alamat publik situs (dipakai WAHA & n8n untuk memanggil balik)
SITE_URL=http://127.0.0.1:8000

# WAHA Plus (server WhatsApp). API key HANYA dipakai di server.
WAHA_BASE_URL=
WAHA_API_KEY=
# Token acak yang dikirim WAHA di header X-SC-Token saat memanggil webhook kita
WAHA_WEBHOOK_TOKEN=

# n8n: webhook penerima kampanye + token dua arah (buat dengan: python -c "import secrets;print(secrets.token_urlsafe(32))")
N8N_BLAST_WEBHOOK_URL=
N8N_BLAST_TOKEN=
N8N_CALLBACK_TOKEN=

# Jeda acak antar-pesan (detik)
BLAST_DELAY_MIN=8
BLAST_DELAY_MAX=20
